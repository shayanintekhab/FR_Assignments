import org.openqa.selenium.By;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.chrome.ChromeDriver;

public class DemoTest {
    public static void main(String[] args) {
        // Set ChromeDriver path
        System.setProperty("webdriver.chrome.driver", "D:\\chromedriver.exe");

        // Launch Chrome
        WebDriver driver = new ChromeDriver();

        // Open Google
        driver.get("https://www.google.com");

        // Accept cookie popup if present
        try {
            WebElement agree = driver.findElement(By.id("L2AGLb"));
            agree.click();
        } catch (Exception e) {
            // Popup not found, continue
        }

        // Find the search box and enter text
        WebElement searchBox = driver.findElement(By.name("q"));
        searchBox.sendKeys("Selenium WebDriver");

        // Sleep to allow Google to render the search button
        try {
            Thread.sleep(1000); // wait 1 second
        } catch (InterruptedException e) {
            e.printStackTrace();
        }

        // Now find the 'Google Search' button
        WebElement searchButton = driver.findElement(By.name("btnK"));
        searchButton.click();

        // Optional wait to view results
        try {
            Thread.sleep(3000);
        } catch (InterruptedException e) {
            e.printStackTrace();
        }

        // Quit browser
        driver.quit();
    }
}
